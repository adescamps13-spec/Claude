 },
 "5": {
  "frame": "E",
  "seconds": 23.76,
  "phrases": [
   {
    "text": "Notre rôle là-dedans ?",
    "start": 0.32,
    "end": 1.82
   },
   {
    "text": "Mettre les bons talents au service du projet,",
    "start": 1.87,
