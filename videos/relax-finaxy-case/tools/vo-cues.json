    "end": 15.62
   },
   {
    "text": "valoriser la stature,",
    "start": 15.67,
    "end": 17.42
   },
   {
    "text": "mais mettre en avant l'humain.",
    "start": 17.47,
    "end": 19.0
   }
  ]
 },
 "4": {
  "frame": "D",
  "seconds": 17.28,
  "phrases": [
   {
    "text": "Puis on a décliné ça sur des supports,",
    "start": 0.38,
