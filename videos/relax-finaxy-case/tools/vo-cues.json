{
 "1": {
  "frame": "A",
  "seconds": 15.08,
  "phrases": [
   {
    "text": "Finaxy est le onzième courtier français.",
    "start": 0.33,
    "end": 3.14
   },
   {
    "text": "Un groupe qui a grandi vite.",
    "start": 3.19,
    "end": 4.93
   },
   {
    "text": "Mais une marque qui avait du mal à exister,",
    "start": 4.98,
    "end": 7.55
   },
   {
    "text": "et qui surtout ne reflétait plus ce que l'entreprise était devenue.",
    "start": 7.6,
    "end": 11.27
   },
   {
    "text": "Pas juste un problème de logo :",
    "start": 11.32,
    "end": 13.16
   },
   {
    "text": "un sujet de cohérence.",
    "start": 13.21,
    "end": 14.72
   }
  ]
 },
 "2": {
  "frame": "B",
  "seconds": 28.68,
  "phrases": [
   {
    "text": "Alors on a commencé par écouter.",
    "start": 0.28,
    "end": 2.48
   },
   {
    "text": "Et on a mis le doigt sur ce que Finaxy était vraiment :",
    "start": 2.53,
    "end": 5.37
   },
   {
    "text": "pas un grand groupe déshumanisé,",
    "start": 5.42,
    "end": 7.38
   },
   {
    "text": "pas non plus un petit courtier de proximité.",
    "start": 7.43,
    "end": 9.57
   },
   {
    "text": "Finaxy cumulait,",
    "start": 9.62,
    "end": 11.17
   },
   {
    "text": "par sa structure,",
    "start": 11.22,
    "end": 12.25
   },
   {
    "text": "la force des deux.",
    "start": 12.3,
    "end": 14.17
   },
   {
    "text": "Finaxy,",
    "start": 14.22,
    "end": 14.65
   },
   {
    "text": "c'est une intelligence collective du risque,",
    "start": 14.7,
    "end": 17.13
   },
   {
    "text": "qui va chercher et activer la bonne expertise sur une problématique dédiée.",
    "start": 17.18,
    "end": 21.61
   },
   {
    "text": "Une proposition de valeur clé :",
    "start": 21.66,
    "end": 23.67
   },
   {
    "text": "dans un monde où le risque est devenu multiple,",
    "start": 23.72,
    "end": 26.33
   },
   {
    "text": "aucune expertise isolée ne suffit.",
    "start": 26.38,
    "end": 28.26
   }
  ]
 },
 "3": {
  "frame": "C",
  "seconds": 19.44,
  "phrases": [
   {
    "text": "De cette promesse,",
    "start": 0.28,
    "end": 1.22
   },
   {
    "text": "nous avons tout décliné :",
    "start": 1.27,
    "end": 2.97
   },
   {
    "text": "architecture,",
